<?xml version="1.0"?>
<robot name="Sumo_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <link name="base_link"/>

    <!-- Chassis link -->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0"/>
    </joint>
    <link name="chassis">
        <visual>
        <origin xyz="0.214 -0.215 0" rpy="-1.5707 3.14 0"/>
            <geometry>
                 <mesh filename="package://diff_drive_robot/meshes/body.STL"/>
            </geometry>
            <material name="Blue">
            <color rgba="0 0 1 1"/>
        </material>
        </visual>
        <collision>
            <origin xyz="0.045 0 0.0575" rpy="0 0 0"/>
            <geometry>
                <box size="0.305 0.430 0.105"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="7.74"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="-0.01" ixy="-0.01" ixz="0" iyy="0.27" iyz="0" izz="0.15"/>
        </inertial>

    </link>

    
 <!-- Left wheel link -->

    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="-0.01 0.175 0.02" rpy="1.5708 0 0"/>
        <child link="left_wheel"/>
        <parent link="base_link"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <collision>
            <geometry>
                <cylinder radius="0.06" length="0.04"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.057 -0.057 -0.03" rpy="0 0 0"/>
            <geometry>
               <mesh filename="package://diff_drive_robot/meshes/wheel.STL"/>
            </geometry>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
<inertial>
    <origin xyz="0 0 0"/>
    <mass value="4.82"/>
    <inertia
        ixx="0.00498"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00498"
        iyz="0.0"
        izz="0.00868"/>
</inertial>
  </link>
     <!-- Right wheel link -->
    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="-0.01 -0.185 0.02" rpy="1.5708 0 0"/>
        <child link="right_wheel"/>
        <parent link="base_link"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <origin xyz="-0.057 -0.057 -0.03" rpy="0 0 0"/>
            <geometry>
               <mesh filename="package://diff_drive_robot/meshes/wheel.STL"/>
            </geometry>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.06" length="0.04"/>
            </geometry>
        </collision>
<inertial>
    <origin xyz="0 0 0"/>
    <mass value="4.82"/>
    <inertia
        ixx="0.00498"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00498"
        iyz="0.0"
        izz="0.00868"/>
</inertial>
    </link>


    <joint name="castor_wheel_left_joint" type="fixed">
        <parent link="base_link"/>
        <child link="castor_wheel_left"/>
        <origin xyz="0.1 0.1 -0.035"/>
    </joint>

    <link name="castor_wheel_left">
        <visual>
            <geometry>
               <mesh filename="package://diff_drive_robot/meshes/caster_left.STL"/>
            </geometry>
            <material name="castor_material">
                <color rgba="0.62 0.62 0.62 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.06 0.06 0.06"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.008"/>
        </inertial>
    </link>

    <joint name="castor_wheel_right_joint" type="fixed">
        <parent link="base_link"/>
        <child link="castor_wheel_right"/>
        <origin xyz="0.1 -0.1 -0.035"/>
    </joint>

    <link name="castor_wheel_right">
        <visual>
            <geometry>
               <mesh filename="package://diff_drive_robot/meshes/caster_right.STL"/>
            </geometry>
            <material name="castor_material">
                <color rgba="0.62 0.62 0.62 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.06 0.06 0.06"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.008"/>
        </inertial>
    </link>
    
    <link name="shield_link">
        <visual>
        <origin xyz="0.18 -0.05 -0.05" rpy="-1.5707 3.14 0"/>
            <geometry>
                <mesh filename="package://diff_drive_robot/meshes/shield.STL"/>
            </geometry>
            <material name="castor_material">
                <color rgba="0.62 0.62 0.62 1.0"/>
            </material>
        </visual>
        <collision>
        <origin xyz="-0.02 0 0.086" rpy=" 0 0 0"/>
            <geometry>
                <box size="0.4 0.1 0.28 "/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1.78"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.04" ixy="0.01" ixz="0" iyx="0.01" iyy="0.03" iyz="0" izz="0.006"/>
        </inertial>
    </link>

    <joint name="shield_joint" type="fixed">
        <parent link="base_link"/>
        <child link="shield_link"/>
        <origin xyz="0.093 0 0.04"/>
    </joint>

    <link name="spinner">
        <visual>
        <origin xyz="0.14 -0.07 -0.145" rpy="-1.5707 3.14 0"/>
            <geometry>
                <mesh filename="package://diff_drive_robot/meshes/spinner.STL"/>
            </geometry>
            <material name="castor_material">
                <color rgba="0.62 0.62 0.62 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0.025 0" rpy="0 -0.753 0"/>
            <geometry>
                <box size="0.25 0.035 0.08"/>
            </geometry>
        </collision>
        <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.5"/>
  <inertia
    ixx="0.003" ixy="0.0" ixz="0.0"
    iyy="0.06"  iyz="0.0"
    izz="0.06"/>
</inertial>
    </link>
    
    <joint name="spinner_joint" type="continuous">
        <origin xyz="0.14 0 0.1" rpy="0 0 0"/>
        <child link="spinner"/>
        <parent link="shield_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    
<link name="left_ramp">
    <visual>
        <origin xyz="0.05 -0.07 0.03" rpy="-1.5707 3.14 0"/>
        <geometry>
            <mesh filename="package://diff_drive_robot/meshes/left_ramp.STL"/>
        </geometry>

        <material name="Silver">
            <color rgba="0.75 0.75 0.75 1"/>
        </material>
    </visual>

    <collision>
        <origin xyz="0.03 0.065 0.05" rpy="0 0.576 0"/>
        <geometry>
            <box size="0.164 0.165 0.005"/>
        </geometry>
    </collision>
    <inertial>
    <origin xyz="0 0 0"/>
    <mass value="7.47"/>
    <inertia
        ixx="0.18"
        ixy="-0.01"
        ixz="0"
        iyx="-0.01"
        iyy="0.27"
        iyz="0"
        izz="0.15"/>
</inertial>
</link>

<joint name="left_ramp_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_ramp"/>
    <origin xyz="0.256 0.07 -0.03"
            rpy="0 0 0"/>
</joint>

<link name="right_ramp">
    <visual>
        <origin xyz="0.05 -0.145 0.03" rpy="-1.5707 3.14 0"/>
        <geometry>
            <mesh filename="package://diff_drive_robot/meshes/right_ramp.STL"/>
        </geometry>

        <material name="Silver">
            <color rgba="0.75 0.75 0.75 1"/>
        </material>
    </visual>

    <collision>
        <origin xyz="0.03 -0.065 0.05" rpy="0 0.576 0"/>
        <geometry>
            <box size="0.164 0.165 0.005"/>
        </geometry>
    </collision>
    <inertial>
    <origin xyz="0 0 0"/>
    <mass value="7.47"/>
    <inertia
        ixx="0.18"
        ixy="-0.01"
        ixz="0"
        iyx="-0.01"
        iyy="0.27"
        iyz="0"
        izz="0.15"/>
</inertial>
</link>

<joint name="right_ramp_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_ramp"/>
    <origin xyz="0.256 -0.07 -0.03"
            rpy="0 0 0"/>
</joint>



<!-- Ultrasonic Front -->

<link name="ultrasonic_front">
    <visual>
        <origin xyz="0 0.029 0.023" rpy="-1.5708 0 -1.5708"/>
        <geometry>
            <mesh filename="package://diff_drive_robot/meshes/ultrasonic.STL"/>
        </geometry>
        <material name="Blue">
            <color rgba="0 0 1 1"/>
        </material>
    </visual>
    <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.02"/>
    <inertia
        ixx="5e-6"
        ixy="0"
        ixz="0"
        iyy="5e-6"
        iyz="0"
        izz="5e-6"/>
</inertial>
</link>

<joint name="ultrasonic_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_front"/>
    <origin xyz="0.2153 -0.03 0.029" rpy="0 0 0"/>
</joint>


<!-- Ultrasonic Left -->

<link name="ultrasonic_left">
    <visual>
        <origin xyz="0 0.038 0.02" rpy="-1.5708 0 -1.5708"/>
        <geometry>
            <mesh filename="package://diff_drive_robot/meshes/ultrasonic.STL"/>
        </geometry>
        <material name="Green">
            <color rgba="0 1 0 1"/>
        </material>
    </visual>
    <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.02"/>
    <inertia
        ixx="5e-6"
        ixy="0"
        ixz="0"
        iyy="5e-6"
        iyz="0"
        izz="5e-6"/>
</inertial>
</link>

<joint name="ultrasonic_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_left"/>
    <origin xyz="0 0.22 0.08" rpy="0 0 1.5708"/>
</joint>


<!-- Ultrasonic Right -->

<link name="ultrasonic_right">
    <visual>
            <origin xyz="0 0.038 0.0197" rpy="-1.5708 0 -1.5708"/>
        <geometry>
            <mesh filename="package://diff_drive_robot/meshes/ultrasonic.STL"/>
        </geometry>
        <material name="Red">
            <color rgba="1 0 0 1"/>
        </material>
    </visual>
    <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.02"/>
    <inertia
        ixx="5e-6"
        ixy="0"
        ixz="0"
        iyy="5e-6"
        iyz="0"
        izz="5e-6"/>
</inertial>
</link>

<joint name="ultrasonic_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_right"/>
    <origin xyz="0 -0.22 0.08" rpy="0 0 -1.5708"/>
</joint>
    
    <!-- IMU Sensor -->
    <joint name="imu_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="base_link"/>
        <child link="imu_link" />
    </joint>

    <link name="imu_link" />

<link name="camera">
    <visual>
        <origin xyz="0.02 -0.04 0" rpy="0 0 1.5707"/>
        <geometry>
            <mesh filename="package://diff_drive_robot/meshes/camera.STL"/>
        </geometry>
<material name="Yellow">
    <color rgba="1 1 0 1"/>
</material>
    </visual>

    <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.08"/>
    <inertia
        ixx="2e-5"
        ixy="0"
        ixz="0"
        iyy="2e-5"
        iyz="0"
        izz="2e-5"/>
</inertial>
</link>

<joint name="camera_joint" type="fixed">
    <parent link="shield_link"/>
    <child link="camera"/>
    <origin xyz="-0.1 0 0.2" rpy="0 0 0"/>
</joint>


        <!-- Gazebo Parameters -->
    <gazebo reference="left_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="right_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="castor_wheel_right">
        <mu1>0.000001</mu1>
        <mu2>0.000001</mu2>
    </gazebo>

    <gazebo reference="castor_wheel_left">
        <mu1>0.000001</mu1>
        <mu2>0.000001</mu2>
    </gazebo>

    <gazebo reference="castor_wheel_left_joint">
    <kp>100000.0</kp>
    <kd>10.0</kd>
</gazebo>

<gazebo reference="castor_wheel_right_joint">
    <kp>100000.0</kp>
    <kd>10.0</kd>
</gazebo>


    <gazebo>
        <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <dimensions>2</dimensions>
        </plugin>
      
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>right_wheel_joint</joint_name>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>spinner_joint</joint_name>
        </plugin>
    
    </gazebo>

    <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>

        <wheel_separation>0.331</wheel_separation>
        <wheel_diameter>0.12</wheel_diameter>

        <command_topic>cmd_vel</command_topic>
        <odometry_topic>odom</odometry_topic>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_link</robot_base_frame>

        <publish_odom>true</publish_odom>
        <publish_wheel_tf>true</publish_wheel_tf>

    </plugin>
</gazebo>

<gazebo reference="imu_link">
        <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>true</visualize>
        <topic>imu</topic>
        <enable_metrics>true</enable_metrics>
        </sensor>
</gazebo>


<gazebo reference="ultrasonic_front">
    <sensor name="front_sensor" type="gpu_lidar">
        <update_rate>20</update_rate>
        <topic>ultrasonic</topic>
        <ray>
            <scan>
                <horizontal>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0</min_angle>
                    <max_angle>0</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.02</min>
                <max>3.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
    </sensor>
</gazebo>

<gazebo reference="ultrasonic_left">
    <sensor name="left_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <topic>ultrasonic</topic>
        <ray>
            <scan>
                <horizontal>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0</min_angle>
                    <max_angle>0</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.02</min>
                <max>3.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
    </sensor>
</gazebo>

<gazebo reference="ultrasonic_right">
    <sensor name="right_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <topic>ultrasonic</topic>
        <ray>
            <scan>
                <horizontal>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0</min_angle>
                    <max_angle>0</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.02</min>
                <max>3.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
    </sensor>
</gazebo>
    
    <gazebo reference="camera">
    <sensor name="camera_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>camera/image</topic>
        <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
                <width>640</width>
                <height>480</height>
                <format>R8G8B8</format>
            </image>
            <clip>
                <near>0.05</near>
                <far>20.0</far>
            </clip>
        </camera>
    </sensor>
</gazebo>
    
</robot>