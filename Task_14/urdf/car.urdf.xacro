<?xml version="1.0"?>
<robot name="lane_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================ PARAMETERS ============================ -->
  <xacro:property name="chassis_x" value="0.40"/>
  <xacro:property name="chassis_y" value="0.24"/>
  <xacro:property name="chassis_z" value="0.10"/>
  <xacro:property name="chassis_mass" value="4.0"/>
  <xacro:property name="ground_clearance" value="0.06"/>

  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.3"/>
  <xacro:property name="wheel_x_offset" value="0.14"/>
  <xacro:property name="wheel_y_offset" value="${chassis_y/2 + wheel_width/2 + 0.01}"/>

  <xacro:property name="camera_tilt" value="0.5"/>  <!-- rad, ~29 deg pitched down -->

  <!-- ============================ MATERIALS ============================ -->
  <material name="chassis_grey"><color rgba="0.2 0.2 0.2 1"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="lidar_dark"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="cam_blue"><color rgba="0.1 0.3 0.8 1"/></material>

  <!-- ============================ BASE / CHASSIS ============================ -->
  <link name="base_link"/>

  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 ${ground_clearance}" rpy="0 0 0"/>
  </joint>

  <link name="chassis_link">
    <visual>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.10"/>
    </inertial>
  </link>

  <!-- ============================ WHEEL MACRO ============================ -->
  <xacro:macro name="wheel" params="prefix x_pos y_pos">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="chassis_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_pos} ${y_pos} ${-ground_clearance + wheel_radius*0}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_pos="${wheel_x_offset}"  y_pos="${wheel_y_offset}"/>
  <xacro:wheel prefix="front_right" x_pos="${wheel_x_offset}"  y_pos="${-wheel_y_offset}"/>
  <xacro:wheel prefix="rear_left"   x_pos="${-wheel_x_offset}" y_pos="${wheel_y_offset}"/>
  <xacro:wheel prefix="rear_right"  x_pos="${-wheel_x_offset}" y_pos="${-wheel_y_offset}"/>

  <!-- ============================ LIDAR (top, center) ============================ -->
  <joint name="lidar_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_z/2 + 0.04}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
      <material name="lidar_dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ============================ CAMERA MACRO ============================ -->
  <!-- Mounted on the sides, pitched down by camera_tilt to look at the
       ground/lane markings. Includes an *_optical_frame child link with
       the standard ROS optical-frame rotation (z-forward, x-right, y-down)
       which is what image processing / lane_detector nodes expect. -->
  <xacro:macro name="side_camera" params="prefix y_pos yaw">
    <joint name="${prefix}_camera_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="${prefix}_camera_link"/>
      <origin xyz="${chassis_x/2 - 0.02} ${y_pos} ${chassis_z/2}"
              rpy="0 ${camera_tilt} ${yaw}"/>
    </joint>

    <link name="${prefix}_camera_link">
      <visual>
        <geometry><box size="0.03 0.03 0.03"/></geometry>
        <material name="cam_blue"/>
      </visual>
      <collision>
        <geometry><box size="0.03 0.03 0.03"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="${prefix}_camera_optical_joint" type="fixed">
      <parent link="${prefix}_camera_link"/>
      <child link="${prefix}_camera_link_optical"/>
      <origin xyz="0 0 0" rpy="${-1.5708} 0 ${-1.5708}"/>
    </joint>
    <link name="${prefix}_camera_link_optical"/>
  </xacro:macro>

  <!-- yaw=0 -> facing forward along the chassis x-axis, tilted down.
       Left camera on +y, right camera on -y side. -->
  <xacro:side_camera prefix="left_side"  y_pos="${chassis_y/2}"  yaw="0"/>
  <xacro:side_camera prefix="right_side" y_pos="${-chassis_y/2}" yaw="0"/>

  <!-- ============================ GAZEBO HARMONIC: DIFF DRIVE ============================ -->
  <!-- Publishes/subscribes on gz-transport topics (gz.msgs.Twist / gz.msgs.Odometry),
       NOT directly on ROS2 topics. The launch file bridges these via ros_gz_bridge. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_y_offset}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- ============================ GAZEBO HARMONIC: LIDAR ============================ -->
  <!-- gz sim publishes gz.msgs.LaserScan on <topic>; ros_gz_bridge converts it to
       sensor_msgs/LaserScan on the ROS2 side (see launch file). No per-sensor
       ROS plugin needed — the world-level Sensors system plugin handles it. -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ============================ GAZEBO HARMONIC: CAMERAS ============================ -->
  <!-- gz sim publishes gz.msgs.Image + gz.msgs.CameraInfo on <topic> / <topic>/camera_info;
       ros_gz_bridge converts these to sensor_msgs/Image + sensor_msgs/CameraInfo. -->
  <xacro:macro name="gazebo_camera" params="prefix topic">
    <gazebo reference="${prefix}_camera_link">
      <sensor name="${prefix}_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <topic>${topic}</topic>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15</far>
          </clip>
          <optical_frame_id>${prefix}_camera_link_optical</optical_frame_id>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:gazebo_camera prefix="left_side"  topic="lcamera/image_raw"/>
  <xacro:gazebo_camera prefix="right_side" topic="rcamera/image_raw"/>

</robot>
